<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="CalcadaSegura" targetNamespace="https://calcada-segura.example/bpmn">
  <bpmn:process id="Triagem" isExecutable="false" name="Triagem territorial de ocorrências">
    <bpmn:startEvent id="Inicio" />
    <bpmn:task id="Leitura" name="Carregar ocorrências" />
    <bpmn:exclusiveGateway id="Item" name="Há item na fila?" />
    <bpmn:task id="Validar" name="Validar dados e localizar" />
    <bpmn:exclusiveGateway id="Valido" name="Dados válidos?" />
    <bpmn:exclusiveGateway id="Duplicar" name="Duplicada?" />
    <bpmn:task id="Priorizar" name="Definir prioridade" />
    <bpmn:task id="Gravar" name="Gravar decisão" />
    <bpmn:task id="Relatorio" name="Exportar relatório e auditoria" />
    <bpmn:endEvent id="Fim" />
    <bpmn:task id="Falha" name="Auditar falha de leitura" />
    <bpmn:endEvent id="FimFalha" />
    <bpmn:task id="Rejeitar" name="Rejeitar ou enviar para revisão" />
    <bpmn:task id="Marcar" name="Marcar duplicada" />
    <bpmn:boundaryEvent id="ErroLeitura" attachedToRef="Leitura">
      <bpmn:errorEventDefinition id="ErroLeituraDef" />
    </bpmn:boundaryEvent>
    <bpmn:textAnnotation id="NotaRegistro">
      <bpmn:text>PATCH falhou: auditar, preservar a ocorrência e continuar o lote. Arquivo com UUID inválido fica apenas na auditoria.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="NotaGravar" sourceRef="Gravar" targetRef="NotaRegistro" />
    <bpmn:sequenceFlow id="Fluxo0" sourceRef="Inicio" targetRef="Leitura" />
    <bpmn:sequenceFlow id="Fluxo1" sourceRef="Leitura" targetRef="Item" />
    <bpmn:sequenceFlow id="Fluxo2" sourceRef="Item" targetRef="Validar" name="Sim" />
    <bpmn:sequenceFlow id="Fluxo3" sourceRef="Item" targetRef="Relatorio" name="Não" />
    <bpmn:sequenceFlow id="Fluxo4" sourceRef="Validar" targetRef="Valido" />
    <bpmn:sequenceFlow id="Fluxo5" sourceRef="Valido" targetRef="Duplicar" name="Sim" />
    <bpmn:sequenceFlow id="Fluxo6" sourceRef="Valido" targetRef="Rejeitar" name="Não" />
    <bpmn:sequenceFlow id="Fluxo7" sourceRef="Duplicar" targetRef="Priorizar" name="Não" />
    <bpmn:sequenceFlow id="Fluxo8" sourceRef="Duplicar" targetRef="Marcar" name="Sim" />
    <bpmn:sequenceFlow id="Fluxo9" sourceRef="Priorizar" targetRef="Gravar" />
    <bpmn:sequenceFlow id="Fluxo10" sourceRef="Rejeitar" targetRef="Gravar" />
    <bpmn:sequenceFlow id="Fluxo11" sourceRef="Marcar" targetRef="Gravar" />
    <bpmn:sequenceFlow id="Fluxo12" sourceRef="Gravar" targetRef="Item" />
    <bpmn:sequenceFlow id="Fluxo13" sourceRef="Relatorio" targetRef="Fim" />
    <bpmn:sequenceFlow id="Fluxo14" sourceRef="ErroLeitura" targetRef="Falha" />
    <bpmn:sequenceFlow id="Fluxo15" sourceRef="Falha" targetRef="FimFalha" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagrama">
